{{- /* Company view: one company's material classifications, grouped by CIK, paginated. */ -}}
{{define "title"}}{{.Company.CompanyName}}{{if .Company.Ticker}} ({{.Company.Ticker}}){{end}} — filings{{end}}
{{define "content"}}
<nav class="detail-back" aria-label="Breadcrumb">
  <a href="/">&larr; Back to all filings</a>
</nav>

<section class="company-header">
  <h2>
    {{.Company.CompanyName}}
    {{if .Company.Ticker}} <small>({{.Company.Ticker}})</small>{{end}}
  </h2>
  <div class="filing-meta">
    <span>CIK {{.Company.CIK}}</span>
    <span>{{.FilingTotal}} material event{{if ne .FilingTotal 1}}s{{end}}</span>
  </div>
</section>

<section class="insider-activity">
  <h3>Insider activity <small>(SEC Form 4)</small></h3>
  {{if or .Pulse30.HasActivity .Pulse90.HasActivity .InsiderTrades}}
    <p class="reasoning">Open-market buys and sells only &mdash; the deliberate trades. Zero here doesn&rsquo;t mean no filings: grants, option exercises and tax withholding (below) are compensation, not market trades.</p>
    <div class="filing-meta">
      <span><strong>Open-market &middot; last 30 days:</strong></span>
      <span class="badge">{{.Pulse30.Buyers}} buyer{{if ne .Pulse30.Buyers 1}}s{{end}} bought {{usd .Pulse30.BuyValue}}</span>
      <span class="badge">{{.Pulse30.Sellers}} seller{{if ne .Pulse30.Sellers 1}}s{{end}} sold {{usd .Pulse30.SellValue}}</span>
    </div>
    <div class="filing-meta">
      <span><strong>Open-market &middot; last 90 days:</strong></span>
      <span>{{.Pulse90.Buyers}} buyer{{if ne .Pulse90.Buyers 1}}s{{end}} bought {{usd .Pulse90.BuyValue}}</span>
      <span>{{.Pulse90.Sellers}} seller{{if ne .Pulse90.Sellers 1}}s{{end}} sold {{usd .Pulse90.SellValue}}</span>
    </div>
    {{if .InsiderTrades}}
      <table class="insider-trades">
        <thead><tr><th>Insider</th><th>Role</th><th>Date</th><th>Transaction</th><th>Shares</th><th>Value</th></tr></thead>
        <tbody>
          {{range .InsiderTrades}}
            <tr>
              <td>{{.OwnerName}}</td>
              <td>{{.Role}}</td>
              <td>{{.TransactionDate}}</td>
              <td>{{txnLabel .Code}}{{if .Is10b51}} <span class="badge">10b5-1</span>{{end}}</td>
              <td>{{printf "%.0f" .Shares}}</td>
              <td>{{usdp .Value}}</td>
            </tr>
          {{end}}
        </tbody>
      </table>
      <small>Most recent {{len .InsiderTrades}} reported transactions. Open-market buys (P) and sells (S) are the deliberate ones; grants and option exercises are compensation. Not investment advice.</small>
    {{end}}
  {{else}}
    <p>No insider (Form&nbsp;4) transactions on record for this company yet.</p>
  {{end}}
</section>

{{if .DisclosureChanges}}
  <section id="risk-radar" class="disclosure-changes">
    <div class="section-head">
      <h3>Risk Radar <small>(year-over-year Risk Factors)</small></h3>
      <a class="back-link" href="/radar">&larr; All Risk Radar</a>
    </div>
    {{range .DisclosureChanges}}
      <div class="diff-group">
        <p class="diff-periods">
          {{if eq .HeadlineDirection "stable"}}
            Risk Factors materially unchanged in fiscal period ending <strong>{{.CurrentPeriod}}</strong>{{if .PriorPeriod}} versus <strong>{{.PriorPeriod}}</strong>{{end}}
          {{else}}
            Fiscal period ending <strong>{{.CurrentPeriod}}</strong>{{if .PriorPeriod}} versus <strong>{{.PriorPeriod}}</strong>{{end}}
          {{end}}
          &mdash; <a href="{{edgarURL .Accession}}" rel="noopener" target="_blank">view filing on EDGAR &rarr;</a>
        </p>

        {{if eq .HeadlineDirection "stable"}}
          {{if .Thesis}}<p class="risk-thesis">{{.Thesis}}</p>{{end}}
          {{if .TopEffects}}
            <p class="top-effects-label">Principal standing risks</p>
            <ul class="top-effects">{{range .TopEffects}}<li>{{.}}</li>{{end}}</ul>
          {{end}}
        {{else}}
          {{if .Thesis}}<p class="risk-thesis">{{.Thesis}}</p>{{end}}

          <p class="risk-glance">
            {{len .SpecificChanges}} company-specific
            {{if .EasedChanges}} &middot; {{len .EasedChanges}} eased/removed{{end}}
            {{if .CommonModeChanges}} &middot; {{len .CommonModeChanges}} common-mode{{end}}
          </p>

          {{if .SpecificChanges}}
            <h4 class="bucket-head">Company-specific changes</h4>
            {{range .SpecificChanges}}
              <article class="filing-card change-specific">
                <div class="filing-meta">
                  <span class="badge">{{changeLabel .ChangeType}}</span>
                  {{if .Realized}}<span class="badge materialized">Materialized</span>{{end}}
                  {{if .NeedsReview}}<span class="badge review">needs review</span>{{end}}
                </div>
                <p class="change-summary">{{.Explanation}}</p>
                {{if .Excerpt}}<p class="change-excerpt">{{.Excerpt}}</p>{{end}}
                {{template "materialized" .}}
              </article>
            {{end}}
          {{end}}

          {{if .EasedChanges}}
            <h4 class="bucket-head improved">Eased / removed</h4>
            {{range .EasedChanges}}
              <article class="filing-card change-eased">
                <div class="filing-meta">
                  <span class="badge">{{changeLabel .ChangeType}}</span>
                  {{if .Realized}}<span class="badge materialized">Materialized</span>{{end}}
                </div>
                <p class="change-summary">{{.Explanation}}</p>
                {{if .Excerpt}}<p class="change-excerpt">{{.Excerpt}}</p>{{end}}
                {{template "materialized" .}}
              </article>
            {{end}}
          {{end}}

          {{if .CommonModeChanges}}
            <details class="common-mode">
              <summary>Also disclosed &mdash; common-mode ({{range $i, $t := .CommonModeThemes}}{{if $i}}, {{end}}{{themeLabel $t.Theme}}{{if gt $t.Count 1}} &times;{{$t.Count}}{{end}}{{end}})</summary>
              {{range .CommonModeChanges}}
                <article class="filing-card change-common">
                  <div class="filing-meta">
                    {{if .MatchedTheme}}<span class="badge">{{themeLabel .MatchedTheme}}</span>{{end}}
                    <span class="badge">{{changeLabel .ChangeType}}</span>
                  </div>
                  {{if .Heading}}<h5>{{.Heading}}</h5>{{end}}
                  <p class="reasoning">{{.Explanation}}</p>
                </article>
              {{end}}
            </details>
          {{end}}

          {{if .Unclassified}}
            <h4 class="bucket-head">Changes</h4>
            {{range .Unclassified}}
              <article class="filing-card">
                <div class="filing-meta">
                  <span class="badge dir-{{.Direction}}">{{dirLabel .Direction}}</span>
                  <span class="badge">{{changeLabel .ChangeType}}</span>
                </div>
                {{if .Heading}}<h5>{{.Heading}}</h5>{{end}}
                <p class="reasoning">{{.Explanation}}</p>
              </article>
            {{end}}
          {{end}}
        {{end}}
      </div>
    {{end}}
    <small>Material year-over-year changes to this company's Risk Factors (Item&nbsp;1A), found by comparing each annual report to the prior year, judged for materiality, and classified as company-specific or common-mode against the cross-company catalog. Common-mode changes are the macro themes many companies disclose in common; they are collapsed above. A filing marked <em>unchanged</em> had no material change from the prior year; its summary describes the company's standing risks, which remain in force. Fiscal periods are the reporting period ends. Not investment advice.</small>
  </section>
{{end}}

{{if .Events}}
  <section>
    {{range .Events}}
      <article class="filing-card">
        <h3><a href="/filings/{{.AccessionNumber}}">{{eventLabel .EventType}}</a></h3>
        <div class="filing-meta">
          {{if .Form}}<span class="badge form">{{.Form}}</span>{{end}}
          <span>filed {{.FilingDate}}</span>
          <span>confidence {{printf "%.0f" (mul .Confidence 100.0)}}%</span>
          {{if .AnchorItemNumber}}<span>{{ anchorLabel .AnchorItemNumber }}</span>{{end}}
        </div>
        <p class="reasoning">{{.Summary}}</p>
        <small><a href="{{edgarURL .AccessionNumber}}" rel="noopener" target="_blank">View raw filing on EDGAR &rarr;</a></small>
      </article>
    {{end}}
  </section>

  {{if or .PrevURL .NextURL}}
    <nav class="pagination" aria-label="Pagination">
      {{if .PrevURL}}
        <a href="{{.PrevURL}}">&larr; Newer</a>
      {{else}}
        <span class="disabled">&larr; Newer</span>
      {{end}}
      <span>{{.RangeStart}}-{{.RangeEnd}} of {{.FilingTotal}}</span>
      {{if .NextURL}}
        <a href="{{.NextURL}}">Older &rarr;</a>
      {{else}}
        <span class="disabled">Older &rarr;</span>
      {{end}}
    </nav>
  {{end}}
{{else}}
  <p>We track this company, but none of its filings have been classified as material yet. New filings land after EDGAR&rsquo;s nightly publish (~10 PM ET).</p>
{{end}}
{{end}}

{{- /* The declared -> materialized track update on a change: the subsequent 8-K that realized it. */ -}}
{{define "materialized"}}
  {{if .Realized}}
    <div class="materialized">
      <span class="materialized-meta">Materialized{{if .RealizingDate}} {{.RealizingDate}}{{end}}{{if .RealizingEventType}} &middot; {{eventLabel .RealizingEventType}}{{end}}</span>
      {{if .RealizingAccession}}<a href="/filings/{{.RealizingAccession}}">view 8-K &rarr;</a>{{end}}
      {{if .RealizationEvidence}}<p class="materialized-evidence">{{.RealizationEvidence}}</p>{{end}}
    </div>
  {{end}}
{{end}}
