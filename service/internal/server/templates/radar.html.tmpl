{{- /* Risk Radar: cross-company feed of company-specific year-over-year risk-factor changes. */ -}}
{{define "title"}}Risk Radar — recent company-specific disclosure changes{{end}}
{{define "content"}}
<section class="company-header">
  <h2>Risk Radar</h2>
  <p class="reasoning">
    Companies whose <strong>10-K Risk Factors surfaced company-specific changes</strong> year over year, newest first. The common-mode boilerplate that the whole market discloses is filtered out. Open a company for the full detail. Not investment advice.
  </p>
</section>

{{if .Rows}}
  <section>
    {{range .Rows}}
      <article class="filing-card">
        <h3>
          <a href="/companies/{{.CIK}}">{{if .Ticker}}{{.Ticker}} &mdash; {{end}}{{.CompanyName}}</a>
        </h3>
        <div class="filing-meta">
          {{if .SpecificCount}}<span>{{.SpecificCount}} company-specific change{{if ne .SpecificCount 1}}s{{end}}</span>{{end}}
          <span>fiscal period {{.CurrentPeriod}}</span>
          {{if .FiledAt}}<span>filed {{.FiledAt}}</span>{{end}}
        </div>
        {{if .TopSpecific}}
          <ul class="radar-specifics">
            {{range .TopSpecific}}<li>{{.}}</li>{{end}}
          </ul>
        {{else if .Thesis}}
          <p class="reasoning">{{firstSentence .Thesis}}</p>
        {{end}}
        <small><a href="/companies/{{.CIK}}#risk-radar">See the full detail &rarr;</a></small>
      </article>
    {{end}}
  </section>

  {{if or .PrevURL .NextURL}}
    <nav class="pagination" aria-label="Pagination">
      {{if .PrevURL}}
        <a href="{{.PrevURL}}">&larr; Newer</a>
      {{else}}
        <span class="disabled">&larr; Newer</span>
      {{end}}
      <span>{{.RangeStart}}-{{.RangeEnd}} of {{.FilteredTotal}}</span>
      {{if .NextURL}}
        <a href="{{.NextURL}}">Older &rarr;</a>
      {{else}}
        <span class="disabled">Older &rarr;</span>
      {{end}}
    </nav>
  {{end}}
{{else}}
  <p>No company-specific disclosure changes on record yet.</p>
{{end}}
{{end}}
